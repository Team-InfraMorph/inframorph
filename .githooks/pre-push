#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo 'main 직접 푸시는 금지됩니다. 작업 브랜치에서 PR을 생성하세요.' >&2
      exit 1
      ;;
    refs/heads/*)
      # Deleting a work branch does not introduce changes.
      case "$local_sha" in *[!0]*) ;; *) continue ;; esac
      python3 "$root/scripts/repo_policy.py" --branch "${remote_ref#refs/heads/}"
      ;;
  esac
done
