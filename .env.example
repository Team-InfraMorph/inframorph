# 복사해서 .env로 사용하세요. 실제 값은 커밋하지 않습니다.
ANTHROPIC_API_KEY=
# Analyzer는 이 값을 프로세스 환경변수로 전달해야 합니다 (.env 자동 로딩 없음).
OPENAI_API_KEY=
AWS_PROFILE=
AWS_REGION=ap-northeast-2
GITHUB_WEBHOOK_SECRET=

# AWS Adapter runtime inputs. Fill these in only in the ignored .env file.
INFRAMORPH_AWS_ACCOUNT_ID=
INFRAMORPH_PLAN=
INFRAMORPH_BUILD_ARTIFACT=
INFRAMORPH_FOUNDATION_OUTPUTS=/tmp/foundation-outputs.json
INFRAMORPH_TF_STATE_BUCKET=
INFRAMORPH_AWS_WORK_DIR=/tmp/inframorph-app
INFRAMORPH_DEPLOYMENT_RECORD=/tmp/inframorph-aws-deployment.json
INFRAMORPH_DEPLOYMENT_ID=
INFRAMORPH_MIGRATION_COMMAND=
INFRAMORPH_DEPLOY_TIMEOUT_SECONDS=900

# Deliberately no environment switches for --execute or rollback compatibility.
